# Smart Elderly Fall Detection Portal - environment configuration
# Copy to `.env` in the project root (read by both the Spring Boot backend and the Python ML service).
# Never commit the real .env file.

# ---------- Database (MongoDB Atlas or local MongoDB) ----------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart_elderly_portal?retryWrites=true&w=majority
MONGODB_DATABASE=smart_elderly_portal

# ---------- Security ----------
# Signs login tokens. Use 32+ random characters, e.g. `py -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=
JWT_EXPIRATION_HOURS=12
# Shared secret between Spring Boot and the ML service (X-Service-Key header).
ML_SERVICE_API_KEY=
# Optional: create the first administrator automatically when no users exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# After the first (admin) account exists, allow other people to self-register as caregivers?
ALLOW_REGISTRATION=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- AI summaries (Groq, Qwen model) ----------
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=20

# ---------- Email (Gmail SMTP with an App Password) ----------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Fallback recipient when no emergency email is saved in the portal settings.
EMERGENCY_EMAIL=

# ---------- ML service ----------
ML_SERVICE_URL=http://localhost:8000
BACKEND_URL=http://localhost:8080/api
ML_HOST=127.0.0.1
ML_PORT=8000
# Defaults for new installations; afterwards they are managed on the Settings page.
FALL_CONFIDENCE_THRESHOLD=0.70
FALL_VERIFICATION_SECONDS=5
# Analysis tuning
ANALYSIS_FPS=6
YOLO_IMGSZ=0
YOLO_PERSON_CONFIDENCE=0.25
MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=900
MAX_CONCURRENT_JOBS=2

# ---------- General ----------
APP_TIMEZONE=Asia/Kolkata
STORAGE_DIR=storage
